# Backend API base URL (Railway). Copy to .env to override locally;
# set VITE_API_URL in Vercel project settings for deployments.
VITE_API_URL=https://backend-production-4d2a.up.railway.app

# Google OAuth web client ID (Google Cloud Console → APIs & Services → Credentials).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
