# Server
PORT=3000

# Local testing: mock Telegram UI in dev/ (no real bot token needed)
DEV_MODE=false
# Session/user storage: memory (local testing) or supabase (production)
STORE=memory

# Telegram bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
# Optional secret sent as x-telegram-bot-api-secret-token on setWebhook
TELEGRAM_WEBHOOK_SECRET=

# OpenAI (legacy, unused unless referenced)
OPENAI_API_KEY=

# Google Gemini (free tier) for text extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Extraction provider: gemini (needs key) or stub (regex fallback)
LLM_PROVIDER=gemini

# Groq (free tier) for voice transcription
GROQ_API_KEY=

# Supabase (service-role key stays server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for health file uploads (see supabase/migrations/0005_storage.sql)
SUPABASE_STORAGE_BUCKET=health-files
# Temp download link TTL in seconds (60..604800, default 3600)
FILE_LINK_TTL_SECONDS=3600
# Max upload bytes per file (default 15MB)
MAX_FILE_BYTES=15728640
